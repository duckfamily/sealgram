+
+class QPainter;
+class QWidget;
+
+namespace Sealgram {
+
+class WindowWallpaper final {
+public:
+	static WindowWallpaper &Instance();
+
+	[[nodiscard]] bool active() const;
+	[[nodiscard]] QString path() const;
+	[[nodiscard]] rpl::producer<QString> pathValue() const;
+
+	bool setPath(const QString &path);
+	void clear();
+	void shutdown();
+
+	// Paints one cover-scaled frame in top-level-window coordinates, so
+	// adjacent widgets (chat list and chat) show one continuous wallpaper.
+	[[nodiscard]] bool paint(
+		QPainter &p,
+		not_null<const QWidget*> widget,
+		QRect clip,
+		QColor tint = QColor(8, 15, 25, 128)) const;
+
+private:
+	WindowWallpaper();
+	~WindowWallpaper();
+
+	class Private;
+	std::unique_ptr<Private> _private;
+	rpl::variable<QString> _path;
+
+};
+
+} // namespace Sealgram
