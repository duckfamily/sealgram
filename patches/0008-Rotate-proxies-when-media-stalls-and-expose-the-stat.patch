+// Why the client moved off a proxy. Shown in the connection dashboard, where
+// "it switched and I do not know why" is exactly the complaint being answered.
+enum class ProxySwitchReason : uchar {
+	Manual,        // the person chose it themselves
+	NoConnection,  // nothing was connecting at all
+	MediaStall,    // messages worked, media did not
+	Bootstrap,     // first proxy on a profile with no account yet
+};
+
+// A proxy as the dashboard sees it.
+struct ProxyStatus {
+	MTP::ProxyData proxy;
+	int ping = 0;              // Milliseconds; meaningless unless `responded`.
+	bool checking = false;
+	bool responded = false;
+	bool current = false;
+	bool mediaFailed = false;
+};
+
+struct ProxySwitchRecord {
+	QString from;              // "host:port", empty when there was none
+	QString to;
+	ProxySwitchReason reason = ProxySwitchReason::Manual;
+	TimeId when = 0;
+	int ping = 0;
+};
