+
+bool ProxyRotationManager::startPendingBootstrap() {
+	if (_pendingBootstrapProxies.empty()) {
+		return false;
+	}
+	auto account = static_cast<Main::Account*>(nullptr);
+	for (const auto &entry : App().domain().accounts()) {
+		if (entry.account->mtpExists()
+			&& !entry.account->mtp().isTestMode()) {
+			account = entry.account.get();
+			break;
+		}
+	}
+	if (!account) {
+		_applyingBootstrapProxy = true;
+		App().setCurrentProxy(
+			_pendingBootstrapProxies.front(),
+			MTP::ProxyData::Settings::Enabled);
+		_applyingBootstrapProxy = false;
+		App().settings().proxy().setProxyRotationEnabled(true);
+		App().saveSettingsDelayed();
+		return true;
+	}
+
+	_checking = true;
+	_bootstrapping = true;
+	_probeOrder.clear();
+	_nextCheckIndex = 0;
+	const auto &settings = App().settings().proxy();
+	for (const auto &proxy : _pendingBootstrapProxies) {
+		const auto index = settings.indexInList(proxy);
+		if (index < 0) {
+			continue;
+		}
+		auto &state = ensure(proxy);
+		state.ping = 0;
+		state.availableAt = 0;
+		state.bootstrapTried = false;
+		_probeOrder.push_back(index);
+	}
+	for (auto i = 0; i != kProxyRotationMaxActiveChecks; ++i) {
+		startNextCheck();
+	}
+	_switchTimer.callOnce(kProxyBootstrapTimeout);
+	return true;
+}
