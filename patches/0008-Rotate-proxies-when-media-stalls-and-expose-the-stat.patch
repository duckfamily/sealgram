+
+int ProxyRotationManager::recentMediaStalls() const {
+	const auto now = crl::now();
+	return int(ranges::count_if(_downloadStalls, [&](crl::time at) {
+		return (now - at) <= kMediaStallWindow;
+	}));
+}
+
+void ProxyRotationManager::recordSwitch(
+		const MTP::ProxyData &to,
+		ProxySwitchReason reason,
+		int ping) {
+	const auto describe = [](const MTP::ProxyData &proxy) {
+		return proxy
+			? (proxy.host + ':' + QString::number(proxy.port))
+			: QString();
+	};
+	const auto &settings = App().settings().proxy();
+	_history.insert(begin(_history), ProxySwitchRecord{
+		.from = settings.isEnabled() ? describe(settings.selected()) : QString(),
+		.to = describe(to),
+		.reason = reason,
+		.when = base::unixtime::now(),
+		.ping = ping,
+	});
+	if (_history.size() > kHistoryLimit) {
+		_history.resize(kHistoryLimit);
+	}
+}
