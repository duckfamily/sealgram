+
+void ProxyRotationManager::watchMediaHealth() {
+	_mediaLifetime.destroy();
+	for (const auto account : productionAccounts()) {
+		account->mtp().restartsByTimeout(
+		) | rpl::filter([](MTP::ShiftedDcId shiftedDcId) {
+			return MTP::isDownloadDcId(shiftedDcId);
+		}) | rpl::on_next([=](MTP::ShiftedDcId shiftedDcId) {
+			noteDownloadStall();
+		}, _mediaLifetime);
+	}
+}
+
+void ProxyRotationManager::noteDownloadStall() {
+	const auto &settings = App().settings().proxy();
+	if (!settings.isEnabled()
+		|| !settings.selected()
+		|| !settings.proxyRotationEnabled()) {
+		// Nothing to blame, or the user asked us not to touch their choice.
+		return;
+	}
+	const auto now = crl::now();
+	_downloadStalls.erase(
+		std::remove_if(
+			_downloadStalls.begin(),
+			_downloadStalls.end(),
+			[&](crl::time at) { return (now - at) > kMediaStallWindow; }),
+		_downloadStalls.end());
+	_downloadStalls.push_back(now);
+	if (int(_downloadStalls.size()) < kMediaStallsToRotate) {
+		return;
+	}
+	_downloadStalls.clear();
+	rotateForMedia();
+	notifyStateChanged();
+}
+
+void ProxyRotationManager::rotateForMedia() {
+	auto &settings = App().settings().proxy();
+	if (settings.list().size() < 2) {
+		LOG(("Proxy: media stalling, but there is nowhere else to go."));
+		return;
+	}
+	const auto current = settings.selected();
+	ensure(current).mediaFailedAt = crl::now();
+	LOG(("Proxy: %1:%2 carries messages but not media, rotating."
+		).arg(current.host).arg(current.port));
+
+	stopChecking();
+	_rotatingForMedia = true;
+	startChecking();
+}
+
+bool ProxyRotationManager::mediaPenalised(
+		const Entry &entry,
+		crl::time now) const {
+	return entry.mediaFailedAt
+		&& ((now - entry.mediaFailedAt) < kMediaFailurePenalty);
+}
+
+void ProxyRotationManager::notifyStateChanged() {
+	_stateChanges.fire({});
