 constexpr auto kProxyRotationCheckInterval = 2 * crl::time(1000);
 constexpr auto kProxyRotationCheckLifetime = 20 * crl::time(1000);
 constexpr auto kProxyRotationMaxActiveChecks = 10;
+constexpr auto kProxyBootstrapTimeout = 20 * crl::time(1000);
+
+// Rotating on media stalls.
+//
+// A proxy can carry the main datacentre perfectly while refusing or throttling
+// the file datacentres, and then messages arrive but photos and videos never
+// load. Rotation alone never noticed, because it only ever looked at
+// mtp().dcstate() - the main datacentre - and stopped the moment that was
+// connected. The signal used here instead is a download session having to be
+// restarted because it timed out, which is upstream's own definition of a
+// stalled download.
+//
+// One timeout is normal on any connection. Several inside one window is the
+// proxy, not the file.
+constexpr auto kMediaStallWindow = 25 * crl::time(1000);
+constexpr auto kMediaStallsToRotate = 3;
+
+// How long a proxy that failed on media is skipped for. Long enough not to come
+// straight back to it, short enough that a proxy which was merely having a bad
+// minute is not lost for the session.
+constexpr auto kMediaFailurePenalty = 10 * 60 * crl::time(1000);
+
+// Media rotation waits far less than the user's rotation timeout before
+// switching. The connection is up and messages work, so there is nothing to wait
+// for beyond hearing back from the candidates.
+constexpr auto kMediaSwitchTimeout = 4 * crl::time(1000);
+
+// Switches kept for the dashboard. Enough to see a pattern, not so many that
+// the page turns into a log file.
+constexpr auto kHistoryLimit = 12;
 
