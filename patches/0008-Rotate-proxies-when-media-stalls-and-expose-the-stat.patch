+void ProxyRotationManager::finishBootstrap() {
+	if (!_bootstrapping || _probeOrder.empty()) {
+		return;
+	}
+	const auto &settings = App().settings().proxy();
+	auto best = MTP::ProxyData();
+	auto bestPing = std::numeric_limits<int>::max();
+	for (const auto index : _probeOrder) {
+		if (index < 0 || index >= int(settings.list().size())) {
+			continue;
+		}
+		const auto &proxy = settings.list()[index];
+		const auto entry = find(proxy);
+		if (entry && entry->ping > 0 && entry->ping < bestPing) {
+			best = proxy;
+			bestPing = entry->ping;
+		}
+	}
+	if (!best) {
+		best = settings.list()[_probeOrder.front()];
+	}
+	_bootstrapping = false;
+	_checkTimer.cancel();
+	_switchTimer.cancel();
+	clearPendingChecks();
+	_checking = false;
+	_pendingBootstrapProxies.clear();
+	_applyingBootstrapProxy = true;
+	App().setCurrentProxy(best, MTP::ProxyData::Settings::Enabled);
+	_applyingBootstrapProxy = false;
+	App().settings().proxy().setProxyRotationEnabled(true);
+	App().finishSealgramProxyBootstrap();
+	App().saveSettingsDelayed();
+	LOG(("Proxy feed: first launch selected best proxy (%1 ms)."
+		).arg(bestPing == std::numeric_limits<int>::max() ? 0 : bestPing));
 }
 
