+
+std::vector<ProxyStatus> ProxyRotationManager::statuses() const {
+	const auto &settings = App().settings().proxy();
+	const auto now = crl::now();
+	const auto selected = settings.selected();
+	const auto enabled = settings.isEnabled();
+
+	auto result = std::vector<ProxyStatus>();
+	result.reserve(settings.list().size());
+	for (const auto &proxy : settings.list()) {
+		auto status = ProxyStatus{
+			.proxy = proxy,
+			.current = enabled && (proxy == selected),
+		};
+		// find() is non-const; the entries are ours and this only reads them.
+		const auto entry = ranges::find(
+			_entries,
+			proxy,
+			&Entry::proxy);
+		if (entry != end(_entries)) {
+			status.ping = entry->ping;
+			status.checking = entry->checking;
+			status.responded = (entry->availableAt != 0);
+			status.mediaFailed = mediaPenalised(*entry, now);
+		}
+		result.push_back(std::move(status));
+	}
+	ranges::sort(result, [](const ProxyStatus &a, const ProxyStatus &b) {
+		// Current first so it is never hunted for, then everything that
+		// answered by how fast it did, then the silent ones.
+		if (a.current != b.current) {
+			return a.current;
+		} else if (a.responded != b.responded) {
+			return a.responded;
+		} else if (a.responded && (a.ping != b.ping)) {
+			return a.ping < b.ping;
+		}
+		return false;
+	});
+	return result;
+}
