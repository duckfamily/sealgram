+#pragma once
+
+#include <optional>
+
+namespace Core {
+
+struct UpdateFeedResult {
+	bool available = false;
+	uint64 version = 0;
+	QString displayVersion;
+	QString installerUrl;
+	QString sourceUrl;
+	QString sha256;
+	QString notes;
+};
+
+void RequestUpdateFeed(Fn<void(std::optional<UpdateFeedResult>)> done);
+
+[[nodiscard]] bool VerifyUpdateFeedSignature(
+	const QByteArray &payload,
+	const QByteArray &signature);
+[[nodiscard]] std::optional<UpdateFeedResult> ParseUpdateFeedPayload(
+	const QByteArray &payload);
+
+[[nodiscard]] bool ShouldShowUpdate(uint64 version);
+void PostponeUpdate(uint64 version);
+
+} // namespace Core
