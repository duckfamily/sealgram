new file mode 100644
index 0000000..ae3d0bf
--- /dev/null
+++ b/Telegram/SourceFiles/mtproto/proxy_feed.h
@@ -0,0 +1,64 @@
+/*
+This file is part of Telegram Desktop,
+the official desktop application for the Telegram messaging service.
+
+For license and copyright information please follow this link:
+https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
+*/
+#pragma once
+
+#include "mtproto/mtproto_proxy_data.h"
+
+#include <vector>
+
+namespace MTP {
+
+struct ProxyFeedResult {
+	std::vector<ProxyData> proxies;
+
+	// Unix time after which the whole list is to be considered dead, even if
+	// the feed stops answering. A public MTProto proxy rarely lasts a day.
+	TimeId expires = 0;
+
+	[[nodiscard]] bool empty() const {
+		return proxies.empty();
+	}
+};
+
+// Fetches a signed list of MTProto proxies over ordinary HTTPS.
+//
+// This exists to break a circular dependency: a client that cannot reach
+// Telegram cannot read a Telegram channel to find a proxy. The feed is served
+// from a host that is reachable when Telegram is not, so discovery happens
+// over a request that looks like any other web traffic.
+//
+// The list is signed with Ed25519 and verified against a key compiled into
+// this binary. A response that fails verification is discarded without a
+// second thought: an unsigned or forged list is an invitation to route all
+// traffic through somebody else's server.
+//
+// Delivers an empty result on any failure - no network, bad signature,
+// malformed payload. Callers should treat that as "no new proxies", never as
+// an error worth bothering the user about.
+void RequestProxyFeed(Fn<void(ProxyFeedResult)> done);
+
+// Which proxies the feed gave us last time, and when they stop counting.
+//
+// Kept apart from the user's own proxy list so that expiry only ever removes
+// what the feed added. Deleting an entry somebody typed in by hand - possibly
+// the only one that works for them - would be unforgivable.
+struct KnownFeedProxies {
+	std::vector<QString> keys; // "host:port"
+	TimeId expires = 0;
+};
+
+[[nodiscard]] KnownFeedProxies LoadKnownFeedProxies();
+void SaveKnownFeedProxies(const KnownFeedProxies &value);
+
+// Verification exposed for tests. `payload` must be the exact bytes that were
+// signed, not a re-serialisation of them.
+[[nodiscard]] bool VerifyProxyFeedSignature(
+	const QByteArray &payload,
+	const QByteArray &signature);
+
+} // namespace MTP
