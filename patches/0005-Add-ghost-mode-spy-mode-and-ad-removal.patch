+void PrivacySettings::beginTemporaryStoryGhost() {
+	if (!_storyRestoreOptions) {
+		_storyRestoreOptions = _ghostOptions.current();
+	}
+	setGhostModeEnabled(true);
+}
+
+void PrivacySettings::finishTemporaryStoryGhost() {
+	if (!_storyRestoreOptions) {
+		return;
+	}
+	const auto restore = *_storyRestoreOptions;
+	_storyRestoreOptions = std::nullopt;
+	if (_ghostOptions.current() == restore) {
+		return;
+	}
+	_ghostOptions = restore;
+	WriteGhostOptions(restore);
+}
+
+int GhostScheduleDelay(int64 sizeBytes, bool usingProxy) {
+	auto result = 12;
+	if (sizeBytes > 0) {
+		const auto sizeMegabytes = sizeBytes / 1024. / 1024.;
+		result += int(std::ceil(std::max(
+			6.,
+			std::ceil(sizeMegabytes * 0.7)))) + 1;
+	}
+	return usingProxy ? ((result * 6 + 4) / 5) : result;
+}
+
+void ApplyGhostScheduling(
+		not_null<Main::Session*> session,
+		Api::SendOptions &options,
+		int64 sizeBytes) {
+	const auto &privacy = PrivacySettings::Instance();
+	if (!privacy.ghostModeEnabled()
+		|| !privacy.useScheduledMessages()
+		|| options.scheduled) {
+		return;
+	}
+	const auto delay = GhostScheduleDelay(
+		sizeBytes,
+		Core::App().settings().proxy().isEnabled());
+	options.scheduled = base::unixtime::now() + delay;
+}
+
+void ArchiveMessageVersion(
+		not_null<Main::Session*> session,
+		not_null<HistoryItem*> item,
+		ArchiveKind kind) {
+	const auto &privacy = PrivacySettings::Instance();
+	if ((kind == ArchiveKind::Deleted && !privacy.saveDeletedMessages())
+		|| (kind == ArchiveKind::Edited && !privacy.saveEditHistory())) {
+		return;
+	}
+	const auto peer = item->history()->peer;
+	if (!privacy.saveBotChats()) {
+		if (const auto user = peer->asUser(); user && user->isBot()) {
+			return;
+		}
+	}
+
+	auto records = std::vector<ArchiveRecord>();
+	auto previousSegments = 0;
+	auto &storage = session->local();
+	if (!LoadArchive(storage, records, previousSegments)) {
+		LOG(("Sealgram archive: refusing to overwrite unreadable archive."));
+		return;
+	}
+	const auto fullId = item->fullId();
+	records.push_back({
+		.kind = kind,
+		.peer = quint64(fullId.peer.value),
+		.message = qint32(fullId.msg.bare),
+		.author = quint64(item->from()->id.value),
+		.date = qint32(item->date()),
+		.replyTo = qint32(item->replyToId().bare),
+		.topic = qint32(item->topicRootId().bare),
+		.text = item->originalText().text,
+		.media = item->media() ? u"cached-media"_q : QString(),
+	});
+
+	const auto oldest = base::unixtime::now() - kArchiveTtl;
+	records.erase(
+		std::remove_if(
+			begin(records),
+			end(records),
+			[=](const ArchiveRecord &record) {
+				return record.date < oldest;
+			}),
+		end(records));
+	if (records.size() > kArchiveMaxRecords) {
+		records.erase(
+			begin(records),
+			begin(records) + (records.size() - kArchiveMaxRecords));
+	}
+	if (!WriteArchive(storage, records)) {
+		LOG(("Sealgram archive: write failed."));
+	}
+}
+
+void ClearPrivacyArchive(not_null<Main::Session*> session) {
+	auto &storage = session->local();
+	auto records = std::vector<ArchiveRecord>();
+	if (!WriteArchive(storage, records)) {
+		LOG(("Sealgram archive: clear failed."));
+	}
+}
+
+} // namespace Sealgram
