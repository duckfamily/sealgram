+std::optional<QByteArray> Account::readSealgramArchiveFile(
+		const QString &name) const {
+	if (!_localKey) {
+		return std::nullopt;
+	}
+	auto file = details::FileReadDescriptor();
+	if (!details::ReadEncryptedFile(file, name, _basePath, _localKey)) {
+		return std::nullopt;
+	}
+	auto payload = QByteArray();
+	file.stream >> payload;
+	if (!details::CheckStreamStatus(file.stream)) {
+		return std::nullopt;
+	}
+	return payload;
+}
+
+bool Account::sealgramArchiveFileExists(const QString &name) const {
+	return QFileInfo::exists(_basePath + name + '0')
+		|| QFileInfo::exists(_basePath + name + '1')
+		|| QFileInfo::exists(_basePath + name);
+}
+
+bool Account::writeSealgramArchiveFile(
+		const QString &name,
+		const QByteArray &payload) {
+	if (!_localKey) {
+		return false;
+	}
+	auto data = details::EncryptedDescriptor(Serialize::bytearraySize(payload));
+	data.stream << payload;
+	auto file = details::FileWriteDescriptor(name, _basePath, true);
+	file.writeEncrypted(data, _localKey);
+	return true;
+}
+
 Account::Account(not_null<Main::Account*> owner, const QString &dataName)
 : _owner(owner)
 , _dataName(dataName)
