+constexpr auto kGhostReadMessages = "sealgram.privacy.ghost-read-messages";
+constexpr auto kGhostReadStories = "sealgram.privacy.ghost-read-stories";
+constexpr auto kGhostOnlineStatus = "sealgram.privacy.ghost-online-status";
+constexpr auto kGhostSendProgress = "sealgram.privacy.ghost-send-progress";
+constexpr auto kGhostAutomaticOffline = "sealgram.privacy.ghost-auto-offline";
+constexpr auto kReadAfterAction = "sealgram.privacy.read-after-action";
+constexpr auto kUseScheduledMessages = "sealgram.privacy.scheduled-messages";
+constexpr auto kSendSilentInGhost = "sealgram.privacy.silent-in-ghost";
+constexpr auto kSendSilentAlways = "sealgram.privacy.silent-always";
+constexpr auto kSuggestGhostForStories = "sealgram.privacy.suggest-story-ghost";
+constexpr auto kSaveDeletedMessages = "sealgram.privacy.save-deleted";
+constexpr auto kSaveEditHistory = "sealgram.privacy.save-edits";
+constexpr auto kSaveBotChats = "sealgram.privacy.save-bots";
+constexpr auto kLocalPremium = "sealgram.privacy.local-premium";
+constexpr auto kDisableAds = "sealgram.privacy.disable-ads";
+constexpr auto kArchiveMagic = quint32(0x53474152); // SGAR
+constexpr auto kArchiveVersion = quint32(1);
+constexpr auto kArchiveMaxRecords = 50000;
+constexpr auto kArchiveSegmentRecords = 512;
+constexpr auto kArchiveMaxSegmentBytes = 4 * 1024 * 1024;
+constexpr auto kArchiveTtl = 90 * 24 * 60 * 60;
+const auto kArchiveManifest = u"sealgram_archive_manifest"_q;
+
+struct ArchiveRecord {
+	ArchiveKind kind = ArchiveKind::Deleted;
+	quint64 peer = 0;
+	qint32 message = 0;
+	quint64 author = 0;
+	qint32 date = 0;
+	qint32 replyTo = 0;
+	qint32 topic = 0;
+	QString text;
+	QString media;
+};
+
+[[nodiscard]] QString ArchiveSegmentName(int index) {
+	return u"sealgram_archive_%1"_q.arg(index, 6, 10, QChar('0'));
+}
+
+void WriteRecord(QDataStream &stream, const ArchiveRecord &record) {
+	stream
+		<< quint8(record.kind)
+		<< record.peer
+		<< record.message
+		<< record.author
+		<< record.date
+		<< record.replyTo
+		<< record.topic
+		<< record.text
+		<< record.media;
+}
+
+[[nodiscard]] bool ReadRecord(
+		QDataStream &stream,
+		ArchiveRecord &record) {
+	auto kind = quint8();
+	stream
+		>> kind
+		>> record.peer
+		>> record.message
+		>> record.author
+		>> record.date
+		>> record.replyTo
+		>> record.topic
+		>> record.text
+		>> record.media;
+	if (stream.status() != QDataStream::Ok
+		|| kind > quint8(ArchiveKind::Edited)) {
+		return false;
+	}
+	record.kind = ArchiveKind(kind);
+	return true;
+}
+
+[[nodiscard]] bool LoadArchive(
+		Storage::Account &storage,
+		std::vector<ArchiveRecord> &records,
+		int &segmentCount) {
+	const auto manifest = storage.readSealgramArchiveFile(kArchiveManifest);
+	if (!manifest) {
+		return !storage.sealgramArchiveFileExists(kArchiveManifest);
+	}
+	auto buffer = QBuffer();
+	buffer.setData(*manifest);
+	buffer.open(QIODevice::ReadOnly);
+	auto stream = QDataStream(&buffer);
+	auto magic = quint32();
+	auto version = quint32();
+	stream >> magic >> version >> segmentCount;
+	if (stream.status() != QDataStream::Ok
+		|| magic != kArchiveMagic
+		|| version != kArchiveVersion
+		|| segmentCount < 0
+		|| segmentCount > 10000) {
+		return false;
+	}
+	for (auto index = 0; index != segmentCount; ++index) {
+		const auto payload = storage.readSealgramArchiveFile(
+			ArchiveSegmentName(index));
+		if (!payload) {
+			return false;
+		}
+		auto segmentBuffer = QBuffer();
+		segmentBuffer.setData(*payload);
+		segmentBuffer.open(QIODevice::ReadOnly);
+		auto segment = QDataStream(&segmentBuffer);
+		auto count = quint32();
+		segment >> count;
+		if (count > kArchiveSegmentRecords) {
+			return false;
+		}
+		for (auto i = quint32(); i != count; ++i) {
+			auto record = ArchiveRecord();
+			if (!ReadRecord(segment, record)) {
+				return false;
+			}
+			records.push_back(std::move(record));
+		}
+		if (segment.status() != QDataStream::Ok) {
+			return false;
+		}
+	}
+	return true;
+}
+
+[[nodiscard]] bool WriteArchive(
+		Storage::Account &storage,
+		const std::vector<ArchiveRecord> &records) {
+	auto segments = std::vector<QByteArray>();
+	auto index = 0;
+	while (index < int(records.size())) {
+		auto payload = QByteArray();
+		auto buffer = QBuffer(&payload);
+		buffer.open(QIODevice::WriteOnly);
+		auto stream = QDataStream(&buffer);
+		const auto countPosition = buffer.pos();
+		stream << quint32(0);
+		auto count = 0;
+		while (index < int(records.size())
+			&& count < kArchiveSegmentRecords) {
+			const auto before = payload.size();
+			WriteRecord(stream, records[index]);
+			if (payload.size() > kArchiveMaxSegmentBytes && count > 0) {
+				payload.truncate(before);
+				buffer.seek(before);
+				break;
+			}
+			++index;
+			++count;
+		}
+		buffer.seek(countPosition);
+		stream << quint32(count);
+		segments.push_back(std::move(payload));
+	}
+	for (auto i = 0; i != int(segments.size()); ++i) {
+		if (!storage.writeSealgramArchiveFile(
+				ArchiveSegmentName(i),
+				segments[i])) {
+			return false;
+		}
+	}
+	auto manifest = QByteArray();
+	auto buffer = QBuffer(&manifest);
+	buffer.open(QIODevice::WriteOnly);
+	auto stream = QDataStream(&buffer);
+	stream
+		<< kArchiveMagic
+		<< kArchiveVersion
+		<< qint32(segments.size());
+	return storage.writeSealgramArchiveFile(kArchiveManifest, manifest);
+}
+constexpr auto kAllGhostOptions = uchar(0x1F);
+
+GhostOptions ReadGhostOptions() {
+	auto result = GhostOptions();
+	const auto add = [&](GhostOption option, const char *key) {
+		if (Core::App().settings().readPref<bool>(key, false)) {
+			result |= option;
+		}
+	};
+	add(GhostOption::ReadMessages, kGhostReadMessages);
+	add(GhostOption::ReadStories, kGhostReadStories);
+	add(GhostOption::OnlineStatus, kGhostOnlineStatus);
+	add(GhostOption::SendProgress, kGhostSendProgress);
+	add(GhostOption::AutomaticOffline, kGhostAutomaticOffline);
+	return result;
+}
+
+SendWithoutSoundMode ReadSendWithoutSound() {
+	auto &settings = Core::App().settings();
+	return settings.readPref<bool>(kSendSilentAlways, false)
+		? SendWithoutSoundMode::Always
+		: settings.readPref<bool>(kSendSilentInGhost, false)
+		? SendWithoutSoundMode::GhostMode
+		: SendWithoutSoundMode::Never;
+}
+
+void WriteGhostOptions(GhostOptions value) {
+	const auto write = [&](GhostOption option, const char *key) {
+		Core::App().settings().writePref<bool>(
+			key,
+			(value & option) != GhostOptions());
+	};
+	write(GhostOption::ReadMessages, kGhostReadMessages);
+	write(GhostOption::ReadStories, kGhostReadStories);
+	write(GhostOption::OnlineStatus, kGhostOnlineStatus);
+	write(GhostOption::SendProgress, kGhostSendProgress);
+	write(GhostOption::AutomaticOffline, kGhostAutomaticOffline);
+}
+
+} // namespace
+
+PrivacySettings &PrivacySettings::Instance() {
+	static auto instance = PrivacySettings();
+	return instance;
+}
+
+PrivacySettings::PrivacySettings()
+: _ghostOptions(ReadGhostOptions())
+, _readAfterAction(Core::App().settings().readPref<bool>(
+	kReadAfterAction,
+	true))
+, _useScheduledMessages(Core::App().settings().readPref<bool>(
+	kUseScheduledMessages,
+	false))
+, _sendWithoutSound(ReadSendWithoutSound())
+, _suggestGhostForStories(Core::App().settings().readPref<bool>(
+	kSuggestGhostForStories,
+	true))
+, _saveDeletedMessages(Core::App().settings().readPref<bool>(
+	kSaveDeletedMessages,
+	true))
+, _saveEditHistory(Core::App().settings().readPref<bool>(
+	kSaveEditHistory,
+	true))
+, _saveBotChats(Core::App().settings().readPref<bool>(
+	kSaveBotChats,
+	false))
+, _localPremium(Core::App().settings().readPref<bool>(
+	kLocalPremium,
+	false))
+, _disableAds(Core::App().settings().readPref<bool>(
+	kDisableAds,
+	true)) {
+	if (_readAfterAction.current() && _useScheduledMessages.current()) {
+		_useScheduledMessages = false;
+		Core::App().settings().writePref<bool>(kUseScheduledMessages, false);
+	}
+}
+
+GhostOptions PrivacySettings::ghostOptions() const {
+	return _ghostOptions.current();
+}
+
+bool PrivacySettings::ghostOption(GhostOption option) const {
+	return (_ghostOptions.current() & option) != GhostOptions();
+}
+
+int PrivacySettings::ghostOptionsCount() const {
+	return std::popcount(uint32(_ghostOptions.current().value()));
+}
+
+bool PrivacySettings::ghostModeEnabled() const {
+	return _ghostOptions.current().value() == kAllGhostOptions;
+}
+
+void PrivacySettings::setGhostOption(GhostOption option, bool enabled) {
+	auto value = _ghostOptions.current();
+	if (enabled) {
+		value |= option;
+	} else {
+		value &= ~GhostOptions(option);
+	}
+	if (value == _ghostOptions.current()) {
+		return;
+	}
+	_ghostOptions = value;
+	WriteGhostOptions(value);
+}
+
+void PrivacySettings::setGhostModeEnabled(bool enabled) {
+	const auto value = GhostOptions::from_raw(
+		enabled ? kAllGhostOptions : uchar(0));
+	if (value == _ghostOptions.current()) {
+		return;
+	}
+	_ghostOptions = value;
+	WriteGhostOptions(value);
+}
