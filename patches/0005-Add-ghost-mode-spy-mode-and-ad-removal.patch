 void Controller::openInMediaView(Media::View::OpenRequest &&request) {
+	if (request.story()) {
+		const auto story = not_null{ request.story() };
+		auto &privacy = Sealgram::PrivacySettings::Instance();
+		if (privacy.suggestGhostForStories()
+			&& !privacy.ghostOption(Sealgram::GhostOption::ReadStories)
+			&& !privacy.ghostModeEnabled()) {
+			const auto controller = request.controller();
+			const auto context = request.storiesContext();
+			show(Ui::MakeConfirmBox({
+				.text = tr::lng_sealgram_story_ghost_text(),
+				.confirmed = [=](Fn<void()> close) {
+					close();
+					Sealgram::PrivacySettings::Instance(
+						).beginTemporaryStoryGhost();
+					_openInMediaViewRequests.fire(
+						Media::View::OpenRequest(
+							controller,
+							story,
+							context));
+				},
+				.cancelled = [=](Fn<void()> close) {
+					close();
+					_openInMediaViewRequests.fire(
+						Media::View::OpenRequest(
+							controller,
+							story,
+							context));
+				},
+				.confirmText = tr::lng_sealgram_story_ghost_enable(),
+				.cancelText = tr::lng_cancel(),
+				.title = tr::lng_sealgram_story_ghost_title(),
+				.strictCancel = true,
+			}));
+			return;
+		}
+	}
 	_openInMediaViewRequests.fire(std::move(request));
