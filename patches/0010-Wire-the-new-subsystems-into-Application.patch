+void Application::refreshProxyFeed() {
+	if (!sealgramProxyFeedEnabled()) {
+		return;
+	}
+	// Drop what the feed gave us last time if it has aged out, before the
+	// network is even consulted: an expired list must not outlive a feed that
+	// has gone away, and every dead proxy costs a connection timeout at
+	// precisely the moment there is no working connection to spare.
+	pruneExpiredFeedProxies();
+
+	MTP::RequestProxyFeed(crl::guard(this, [=](MTP::ProxyFeedResult result) {
+		if (sealgramProxyFeedEnabled() && !result.empty()) {
+			applyProxyFeed(result);
+		}
+	}));
+}
+
+void Application::checkSealgramUpdate(UpdateCheckSource source) {
+	if (source == UpdateCheckSource::Automatic
+		&& !sealgramUpdateChecksEnabled()) {
+		return;
+	}
+	if (_updateFeedRequestInProgress) {
+		if (source == UpdateCheckSource::Manual) {
+			_updateFeedRequestSource = source;
+		}
+		return;
+	}
+	_updateFeedRequestInProgress = true;
+	_updateFeedRequestSource = source;
+
+	RequestUpdateFeed(crl::guard(this, [=](
+			std::optional<UpdateFeedResult> result) {
+		const auto requestSource = _updateFeedRequestSource;
+		_updateFeedRequestInProgress = false;
+		if (requestSource == UpdateCheckSource::Automatic
+			&& !sealgramUpdateChecksEnabled()) {
+			return;
+		}
+		const auto window = _lastActivePrimaryWindow;
+		if (!window) {
+			return;
+		}
+		if (!result) {
+			if (requestSource == UpdateCheckSource::Manual) {
+				ShowSealgramUpdateResult(window, false);
+			}
+			return;
+		}
+		const auto newer = result->available
+			&& (result->version > AppVersion);
+		if (!newer) {
+			if (requestSource == UpdateCheckSource::Manual) {
+				ShowSealgramUpdateResult(window, true);
+			}
+			return;
+		}
+		if (requestSource == UpdateCheckSource::Automatic
+			&& !ShouldShowUpdate(result->version)) {
+			return;
+		}
+		ShowSealgramUpdate(window, *result);
+	}));
+}
+
+void Application::pruneExpiredFeedProxies() {
+	const auto known = MTP::LoadKnownFeedProxies();
+	if (known.keys.empty()
+		|| !known.expires
+		|| base::unixtime::now() < known.expires) {
+		return;
+	}
+	removeFeedProxies(known.keys);
+	MTP::SaveKnownFeedProxies({});
+	LOG(("Proxy feed: dropped %1 expired entries.").arg(known.keys.size()));
+	saveSettingsDelayed();
+}
+
+void Application::removeFeedProxies(const std::vector<QString> &keys) {
+	auto &proxy = settings().proxy();
+	const auto selected = proxy.selected();
+	for (const auto &key : keys) {
+		const auto separator = key.lastIndexOf(':');
+		if (separator <= 0) {
+			continue;
+		}
+		const auto host = key.mid(0, separator);
+		const auto port = key.mid(separator + 1).toUInt();
+		for (const auto &entry : proxy.list()) {
+			if (entry.type != MTP::ProxyData::Type::Mtproto
+				|| entry.host != host
+				|| entry.port != port) {
+				continue;
+			}
+			// Never pull the rug from under a live connection. If this is the
+			// proxy currently carrying traffic, leave it: rotation will move on
+			// when it stops answering, which is the safe moment to drop it.
+			if (entry != selected) {
+				const auto removed = proxy.removeFromList(entry);
+				Assert(removed);
+			}
+			break;
+		}
+	}
+}
+
+void Application::applyProxyFeed(const MTP::ProxyFeedResult &result) {
+	auto &proxy = settings().proxy();
+	const auto completed = settings().readPref<bool>(
+		kSealgramProxyBootstrapCompleted,
+		false);
+	const auto pending = settings().readPref<bool>(
+		kSealgramProxyBootstrapPending,
+		false);
+	const auto pristine = !proxy.isEnabled() && proxy.list().empty();
+	const auto bootstrap = !completed && (pending || pristine);
+	if (!completed && !pending && !pristine) {
+		// This profile already had an explicit proxy setup when the bootstrap
+		// feature first appeared. Never replace that existing user choice.
+		finishSealgramProxyBootstrap();
+	}
+
+	auto keys = std::vector<QString>();
+	auto fresh = base::flat_set<QString>();
+	keys.reserve(result.proxies.size());
+	for (const auto &entry : result.proxies) {
+		auto key = entry.host + ':' + QString::number(entry.port);
+		fresh.emplace(key);
+		keys.push_back(std::move(key));
+	}
+
+	// Anything the feed served before and no longer serves has fallen out of
+	// the channels, which is the best available signal that it stopped working.
+	auto stale = std::vector<QString>();
+	for (const auto &key : MTP::LoadKnownFeedProxies().keys) {
+		if (!fresh.contains(key)) {
+			stale.push_back(key);
+		}
+	}
+	removeFeedProxies(stale);
+
+	auto added = 0;
+	for (const auto &entry : result.proxies) {
+		if (proxy.indexInList(entry) < 0) {
+			proxy.addToList(entry);
+			++added;
+		}
+	}
+
+	MTP::SaveKnownFeedProxies({ .keys = keys, .expires = result.expires });
+
+	LOG(("Proxy feed: +%1 new, -%2 stale, %3 in the list."
+		).arg(added
+		).arg(stale.size()
+		).arg(proxy.list().size()));
+
+	saveSettingsDelayed();
+
+	if (bootstrap) {
+		settings().writePref<bool>(
+			kSealgramProxyBootstrapPending,
+			true);
+		_private->proxyRotation->bootstrapBestProxy(result.proxies);
+		saveSettingsDelayed();
+		return;
+	}
+
+	// Give the direct connection a fair chance first. Startup is slow, and a
+	// client that flipped to a proxy the moment it opened would be rerouting
+	// traffic for people whose network is perfectly fine.
+	_proxyFallback.callOnce(kProxyFallbackDelay);
+}
+
+void Application::considerProxyFallback() {
+	auto &proxy = settings().proxy();
+	if (!sealgramProxyFeedEnabled()
+		|| proxy.isEnabled()
+		|| proxy.list().empty()) {
+		return; // Already going through a proxy, or nothing to go through.
+	}
+
+	// Step in only when nothing at all is connected. One healthy account means
+	// the network works and there is nothing here to fix.
+	//
+	// Deliberately keyed on the MTProto instance rather than on a session: the
+	// person this is for is most likely sitting on the login screen, unable to
+	// authorise precisely because nothing gets through. Requiring a session
+	// would have skipped them.
+	auto anyProduction = false;
+	for (const auto &entry : domain().accounts()) {
+		const auto account = entry.account.get();
+		if (!account->mtpExists() || account->mtp().isTestMode()) {
+			continue;
+		} else if (account->mtp().dcstate() == MTP::ConnectedState) {
+			return;
+		}
+		anyProduction = true;
+	}
+	if (!anyProduction) {
+		return;
+	}
+
+	// Freshest first, as served. Rotation takes it from here: it probes the
+	// list, measures each candidate and moves on when the current one stops
+	// answering - that is what makes this survive a proxy dying mid-session.
+	proxy.setSelected(proxy.list().front());
+	proxy.setSettings(MTP::ProxyData::Settings::Enabled);
+	proxy.setProxyRotationEnabled(true);
+	proxy.connectionTypeChangesNotify();
+	refreshGlobalProxy();
+	saveSettingsDelayed();
+
+	LOG(("Proxy feed: nothing connected after %1s, enabling a proxy."
+		).arg(kProxyFallbackDelay / 1000));
+}
