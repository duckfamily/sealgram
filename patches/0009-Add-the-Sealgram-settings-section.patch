+SealgramCover::SealgramCover(QWidget *parent)
+: RpWidget(parent)
+, _title(Ui::CreateChild<Ui::FlatLabel>(
+	this,
+	tr::lng_sealgram_desktop_version(
+		lt_version,
+		rpl::single(QString::fromLatin1(AppVersionStr))),
+	st::settingsCoverName))
+, _description(Ui::CreateChild<Ui::FlatLabel>(
+	this,
+	tr::lng_sealgram_description(),
+	st::settingsCoverStatus)) {
+	resize(0, st::sealgramCoverHeight);
+	_title->setAttribute(Qt::WA_TransparentForMouseEvents);
+	_description->setAttribute(Qt::WA_TransparentForMouseEvents);
+
+	rpl::combine(
+		widthValue(),
+		_title->widthValue(),
+		_description->widthValue()
+	) | rpl::on_next([=](int width, int titleWidth, int descriptionWidth) {
+		_title->moveToLeft(
+			(width - titleWidth) / 2,
+			st::sealgramCoverTitleTop);
+		_description->moveToLeft(
+			(width - descriptionWidth) / 2,
+			st::sealgramCoverDescriptionTop);
+	}, lifetime());
+}
+
+void SealgramCover::paintEvent(QPaintEvent *e) {
+	auto p = Painter(this);
+	p.setClipRect(e->rect());
+	p.setRenderHint(QPainter::SmoothPixmapTransform);
+	const auto left = (width() - st::sealgramCoverLogoSize) / 2;
+	p.drawImage(
+		QRect(
+			left,
+			st::sealgramCoverLogoTop,
+			st::sealgramCoverLogoSize,
+			st::sealgramCoverLogoSize),
+		Window::LogoNoMargin());
+}
+
+[[nodiscard]] rpl::producer<QString> MitigationStatusText(
+		Core::MitigationState state) {
+	switch (state) {
+	case Core::MitigationState::Applied:
+		return tr::lng_sealgram_status_applied();
+	case Core::MitigationState::DisabledByEnvironment:
+		return tr::lng_sealgram_status_disabled_environment();
+	case Core::MitigationState::Failed:
+		return tr::lng_sealgram_status_failed();
+	case Core::MitigationState::Unsupported:
+		return tr::lng_sealgram_status_unsupported();
+	}
+	Unexpected("MitigationState in MitigationStatusText.");
+}
