+// Anything the dashboard shows changes on its own - a probe answers, a switch
+// happens, a download stalls - so the page repaints on a slow tick as well as on
+// the manager's own notifications. Two seconds is unnoticeable as latency and
+// costs nothing next to a settings page that is open for a few seconds.
+constexpr auto kDashboardTick = crl::time(2000);
+
+[[nodiscard]] QString DescribeProxy(const MTP::ProxyData &proxy) {
+	return proxy.host + ':' + QString::number(proxy.port);
+}
+
+[[nodiscard]] rpl::producer<> DashboardChanges() {
+	return rpl::single(rpl::empty) | rpl::then(rpl::merge(
+		Core::App().proxyRotation().stateChanges(),
+		Core::App().settings().proxy().connectionTypeChanges(),
+		base::timer_each(kDashboardTick)));
+}
+
+[[nodiscard]] rpl::producer<QString> ConnectionStateText() {
+	return DashboardChanges() | rpl::map([] {
+		auto connecting = false;
+		for (const auto &entry : Core::App().domain().accounts()) {
+			const auto account = entry.account.get();
+			if (!account->mtpExists() || account->mtp().isTestMode()) {
+				continue;
+			} else if (account->mtp().dcstate() == MTP::ConnectedState) {
+				return tr::lng_sealgram_connection_connected(tr::now);
+			}
+			connecting = true;
+		}
+		return connecting
+			? tr::lng_sealgram_connection_connecting(tr::now)
+			: tr::lng_sealgram_connection_waiting(tr::now);
+	});
+}
+
+[[nodiscard]] rpl::producer<QString> CurrentProxyText() {
+	return DashboardChanges() | rpl::map([] {
+		const auto &proxy = Core::App().settings().proxy();
+		return (proxy.isEnabled() && proxy.selected())
+			? DescribeProxy(proxy.selected())
+			: tr::lng_sealgram_connection_direct(tr::now);
+	});
+}
+
+[[nodiscard]] rpl::producer<QString> CurrentPingText() {
+	return DashboardChanges() | rpl::map([] {
+		for (const auto &status : Core::App().proxyRotation().statuses()) {
+			if (status.current) {
+				return status.responded
+					? tr::lng_sealgram_connection_ping_value(
+						tr::now,
+						lt_ping,
+						QString::number(status.ping))
+					: tr::lng_sealgram_connection_silent(tr::now);
+			}
+		}
+		return QString();
+	});
+}
+
+[[nodiscard]] rpl::producer<QString> MediaHealthText() {
+	return DashboardChanges() | rpl::map([] {
+		const auto stalls = Core::App().proxyRotation().recentMediaStalls();
+		return stalls
+			? tr::lng_sealgram_connection_media_stalls(tr::now, lt_count, stalls)
+			: tr::lng_sealgram_connection_media_ok(tr::now);
+	});
+}
+
+[[nodiscard]] QString DescribeReason(Core::ProxySwitchReason reason) {
+	using Reason = Core::ProxySwitchReason;
+	switch (reason) {
+	case Reason::Manual:
+		return tr::lng_sealgram_connection_reason_manual(tr::now);
+	case Reason::NoConnection:
+		return tr::lng_sealgram_connection_reason_noconnection(tr::now);
+	case Reason::MediaStall:
+		return tr::lng_sealgram_connection_reason_media(tr::now);
+	case Reason::Bootstrap:
+		return tr::lng_sealgram_connection_reason_bootstrap(tr::now);
+	}
+	return QString();
+}
