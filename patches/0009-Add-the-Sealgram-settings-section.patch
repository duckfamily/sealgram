+void BuildSealgramPrivacy(SectionBuilder &builder) {
+	const auto privacy = &Sealgram::PrivacySettings::Instance();
+	const auto session = builder.session();
+	const auto controller = builder.controller();
+	const auto addToggle = [&](QString id,
+			rpl::producer<QString> title,
+			rpl::producer<bool> value,
+			Fn<bool()> current,
+			Fn<void(bool)> setter,
+			QStringList keywords = {}) {
+		const auto toggle = builder.addButton({
+			.id = std::move(id),
+			.title = std::move(title),
+			.st = &st::settingsButtonNoIcon,
+			.toggled = std::move(value),
+			.keywords = std::move(keywords),
+		});
+		if (toggle) {
+			toggle->toggledValue(
+			) | rpl::filter([=](bool enabled) {
+				return enabled != current();
+			}) | rpl::on_next([=](bool enabled) {
+				setter(enabled);
+			}, toggle->lifetime());
+		}
+		return toggle;
+	};
+	const auto ghostValue = [&](Sealgram::GhostOption option) {
+		return privacy->ghostOptionsValue(
+		) | rpl::map([=](Sealgram::GhostOptions options) {
+			return (options & option) != Sealgram::GhostOptions();
+		});
+	};
+	const auto setGhost = [=](Sealgram::GhostOption option, bool enabled) {
+		privacy->setGhostOption(option, enabled);
+		if (option == Sealgram::GhostOption::OnlineStatus
+			|| option == Sealgram::GhostOption::AutomaticOffline) {
+			session->updates().updateOnline(0);
+		}
+	};
+
+	builder.addSkip();
+	builder.addSubsectionTitle({
+		.id = u"sealgram/privacy/ghost"_q,
+		.title = tr::lng_sealgram_ghost_mode(),
+		.keywords = { u"ghost"_q, u"invisible"_q, u"призрак"_q },
+	});
+	addToggle(
+		u"sealgram/privacy/ghost-master"_q,
+		privacy->ghostOptionsValue(
+		) | rpl::map([=](Sealgram::GhostOptions) {
+			return tr::lng_sealgram_ghost_mode(tr::now)
+				+ u" %1/5"_q.arg(privacy->ghostOptionsCount());
+		}),
+		privacy->ghostOptionsValue(
+		) | rpl::map([=](Sealgram::GhostOptions) {
+			return privacy->ghostModeEnabled();
+		}),
+		[=] { return privacy->ghostModeEnabled(); },
+		[=](bool enabled) {
+			privacy->setGhostModeEnabled(enabled);
+			session->updates().updateOnline(0);
+		});
+	addToggle(
+		u"sealgram/privacy/read-messages"_q,
+		tr::lng_sealgram_dont_read_messages(),
+		ghostValue(Sealgram::GhostOption::ReadMessages),
+		[=] {
+			return privacy->ghostOption(
+				Sealgram::GhostOption::ReadMessages);
+		},
+		[=](bool enabled) {
+			setGhost(Sealgram::GhostOption::ReadMessages, enabled);
+		});
+	addToggle(
+		u"sealgram/privacy/read-stories"_q,
+		tr::lng_sealgram_dont_read_stories(),
+		ghostValue(Sealgram::GhostOption::ReadStories),
+		[=] {
+			return privacy->ghostOption(
+				Sealgram::GhostOption::ReadStories);
+		},
+		[=](bool enabled) {
+			setGhost(Sealgram::GhostOption::ReadStories, enabled);
+		});
+	addToggle(
+		u"sealgram/privacy/online"_q,
+		tr::lng_sealgram_dont_send_online(),
+		ghostValue(Sealgram::GhostOption::OnlineStatus),
+		[=] {
+			return privacy->ghostOption(
+				Sealgram::GhostOption::OnlineStatus);
+		},
+		[=](bool enabled) {
+			setGhost(Sealgram::GhostOption::OnlineStatus, enabled);
+		});
+	addToggle(
+		u"sealgram/privacy/progress"_q,
+		tr::lng_sealgram_dont_send_progress(),
+		ghostValue(Sealgram::GhostOption::SendProgress),
+		[=] {
+			return privacy->ghostOption(
