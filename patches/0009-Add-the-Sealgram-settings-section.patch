+// The proxy list and the switch history both change length, so neither can be
+// built from fixed rows. Both are rebuilt into a plain layout whenever anything
+// moves.
+class DashboardList final : public Ui::RpWidget {
+public:
+	DashboardList(
+		QWidget *parent,
+		Fn<void(not_null<Ui::VerticalLayout*>)> fill);
+
+private:
+	void rebuild();
+
+	object_ptr<Ui::VerticalLayout> _inner;
+	Fn<void(not_null<Ui::VerticalLayout*>)> _fill;
+
+};
+
+DashboardList::DashboardList(
+	QWidget *parent,
+	Fn<void(not_null<Ui::VerticalLayout*>)> fill)
+: RpWidget(parent)
+, _inner(this)
+, _fill(std::move(fill)) {
+	_inner->show();
+	rebuild();
+	DashboardChanges() | rpl::on_next([=] {
+		rebuild();
+	}, lifetime());
+	widthValue() | rpl::on_next([=](int width) {
+		_inner->resizeToWidth(width);
+	}, lifetime());
+	_inner->heightValue() | rpl::on_next([=](int height) {
+		resize(width(), height);
+	}, lifetime());
+}
+
+void DashboardList::rebuild() {
+	while (_inner->count() > 0) {
+		delete _inner->widgetAt(0);
+	}
+	_fill(_inner.data());
+	_inner->resizeToWidth(width());
+}
+
+void FillProxyList(not_null<Ui::VerticalLayout*> container) {
+	const auto statuses = Core::App().proxyRotation().statuses();
+	if (statuses.empty()) {
+		container->add(
+			object_ptr<Ui::FlatLabel>(
+				container,
+				tr::lng_sealgram_connection_none(tr::now),
+				st::boxDividerLabel),
+			st::settingsDividerLabelPadding);
+		return;
+	}
+	for (const auto &status : statuses) {
+		auto notes = QStringList();
+		if (status.current) {
+			notes.push_back(tr::lng_sealgram_connection_current(tr::now));
+		}
+		if (status.mediaFailed) {
+			notes.push_back(tr::lng_sealgram_connection_media_failed(tr::now));
+		}
+		const auto measurement = status.checking
+			? tr::lng_sealgram_connection_checking(tr::now)
+			: status.responded
+			? tr::lng_sealgram_connection_ping_value(
+				tr::now,
+				lt_ping,
+				QString::number(status.ping))
+			: tr::lng_sealgram_connection_silent(tr::now);
+		notes.push_front(measurement);
+
+		const auto proxy = status.proxy;
+		const auto button = container->add(
+			object_ptr<Ui::SettingsButton>(
+				container,
+				rpl::single(DescribeProxy(proxy)),
+				st::settingsButtonNoIcon));
+		Settings::CreateRightLabel(
+			button,
+			rpl::single(notes.join(u", "_q)),
+			st::settingsButtonNoIcon,
+			rpl::single(DescribeProxy(proxy)));
+		button->setClickedCallback([=] {
+			// Switching by hand also cancels whatever the rotation was in the
+			// middle of, so the choice is not undone a second later.
+			Core::App().setCurrentProxy(
+				proxy,
+				MTP::ProxyData::Settings::Enabled);
+			Core::App().saveSettingsDelayed();
+		});
+	}
+}
+
+void FillSwitchHistory(not_null<Ui::VerticalLayout*> container) {
+	const auto &history = Core::App().proxyRotation().history();
+	if (history.empty()) {
+		container->add(
+			object_ptr<Ui::FlatLabel>(
+				container,
+				tr::lng_sealgram_connection_history_empty(tr::now),
+				st::boxDividerLabel),
+			st::settingsDividerLabelPadding);
+		return;
+	}
+	for (const auto &record : history) {
+		const auto when = base::unixtime::parse(record.when).toString("HH:mm");
+		const auto text = record.from.isEmpty()
+			? u"%1  %2"_q.arg(when, record.to)
+			: u"%1  %2 → %3"_q.arg(when, record.from, record.to);
+		container->add(
+			object_ptr<Ui::FlatLabel>(
+				container,
+				text + u" — "_q + DescribeReason(record.reason),
+				st::boxDividerLabel),
+			st::settingsDividerLabelPadding);
+	}
+}
