+		.icon = { &st::menuIconNetwork },
+		.keywords = { u"network"_q, u"proxy"_q, u"rotation"_q },
+	});
+	builder.addSectionButton({
+		.title = tr::lng_sealgram_appearance(),
+		.targetSection = SealgramAppearance::Id(),
